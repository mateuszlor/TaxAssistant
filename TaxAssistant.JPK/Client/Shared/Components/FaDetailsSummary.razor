@using TaxAssistant.JPK.Shared.Model
@using Microsoft.AspNetCore.Components.Forms
@using TaxAssistant.JPK.Shared.Model.Database.Fa

@if (@Fa == null)
{
    <Loading />
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Invoices</th>
                <th>Total rows</th>
                <th>Total amount</th>
                <th>From date</th>
                <th>To date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Declared</td>
                <td>@Fa.ControlData.InvoicesCount</td>
                <td>@Fa.ControlData.InvoiceRowsCount</td>
                <td>@Fa.ControlData.TotalIncomeFromInvoices</td>
                <td>@Fa.Header?.DateFrom.ToShortDateString()</td>
                <td>@Fa.Header?.DateTo.ToShortDateString()</td>
            </tr>
            <tr>
                <td>Actual</td>
                <td>@Fa.Invoices.Count</td>
                <td>@Fa.Invoices.Sum(x => x.Rows.Count)</td>
                <td>@Fa.Invoices.Sum(x => x.Rows.Sum(r => r.TotalPriceGross))</td>
                <td>@Fa.Invoices.Min(x => x.IssueDate).ToShortDateString()</td>
                <td>@Fa.Invoices.Max(x => x.IssueDate).ToShortDateString()</td>
            </tr>
        </tbody>
    </table>
}

@code {
    [Parameter]
    public required Fa Fa { get; set; }
}
