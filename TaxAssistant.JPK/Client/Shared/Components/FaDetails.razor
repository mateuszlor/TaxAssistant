@using Newtonsoft.Json
@using TaxAssistant.JPK.Shared.Model
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Text.Json.Serialization
@using TaxAssistant.JPK.Shared.Model.Database.Fa
@using TaxAssistant.JPK.Client.Clients.Abstraction
@using TaxAssistant.JPK.Client.Shared.Components

@inject IApiClient<Fa> Client

@if (isLoading)
{
	<Loading />
}
else if (@fa == null)
{
	<p class="error">Invalid data</p>
}
else
{
	<h3>Summary:</h3>
	<FaDetailsSummary Fa=@fa />

	<h3>Invoices:</h3>

	@foreach (var invoice in fa.Invoices)
	{
		<hr />
		<FaInvoiceDetails Invoice=@invoice LinkToSingleInvoice=true />
	}

	<h3>Orders:</h3>
	<span>TODO</span>
}

@code {
	[Parameter]
	public Guid FaId { get; set; }

	private Fa? fa;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		isLoading = true;

		try
		{
			fa = await Client.GetAsync(FaId);
		}
		finally
		{
			isLoading = false;
		}
	}
}
